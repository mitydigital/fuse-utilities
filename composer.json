{
    "name": "mitydigital/fuse-utilities",
    "description": "Utilities for Mity Digital's Fuse Starter Kit.",
    "type": "statamic-addon",
    "keywords": [
        "statamic"
    ],
    "autoload": {
        "psr-4": {
            "MityDigital\\FuseUtilities\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MityDigital\\FuseUtilities\\Tests\\": "tests"
        }
    },
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Marty Friedel"
        }
    ],
    "require": {
	    "php": "^8.5",
        "statamic/cms": "^6.0",
        "spatie/laravel-ray": "^1.43",
        "aryehraber/statamic-captcha": "^1.17",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11",
        "laravel/pint": "^1.10",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/boost": "^2.4"
    },
    "extra": {
        "statamic": {
            "name": "Fuse Utilities",
            "description": "Utilities for Mity Digital's Fuse Starter Kit."
        },
        "laravel": {
            "providers": [
                "MityDigital\\FuseUtilities\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "php -d memory_limit=-1 -d max_execution_time=0 ./vendor/bin/pest"
        ],
        "pint": [
            "./vendor/bin/pint"
        ]
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    }
}
